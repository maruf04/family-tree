# PostgreSQL connection used by the migration runner and the API.
# Locally: a plain Postgres database. In production: the Supabase "direct connection" string.
# This role must own the tables (or have BYPASSRLS): RLS is enabled with default-deny.
DATABASE_URL=postgres://heritage:heritage@127.0.0.1:5432/heritage_dev

# Used ONLY by database tests. The test helper wipes this database, so the name must end in "_test".
TEST_DATABASE_URL=postgres://heritage:heritage@127.0.0.1:5432/heritage_test

# Supabase (added in the authentication milestone). The service-role key is backend-only.
# Until these are set, development uses a sample-user login (disabled in production).
#SUPABASE_URL=
# SUPABASE_JWT_SECRET=              # only for projects still using the legacy HS256 secret
#SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=heritage-private
#VITE_SUPABASE_URL=            # sent to the browser
#VITE_SUPABASE_ANON_KEY=        # sent to the browser (safe: RLS denies it everything)

# API
# API_PORT=4000
# CORS_ORIGIN=http://localhost:5173

# Live site (docs/LAUNCH.md). Supabase > Connect > Session pooler (port 5432).
# Used only by the prod:* and backup commands on your own computer.
# PRODUCTION_DATABASE_URL=
# Optional: Supabase's certificate on one line with \n for line breaks, to verify the server.
# DATABASE_CA_CERT=
